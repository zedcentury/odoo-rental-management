<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="category_rental" model="ir.module.category">
            <field name="name">Rental</field>
            <field name="parent_id" ref="base.module_category_administration"/>
        </record>

        <record id="group_rental_readonly" model="res.groups">
            <field name="name">Readonly</field>
            <field name="category_id" ref="category_rental"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user'))
            ]"/>
        </record>

        <record id="group_rental_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_readonly'))]"/>
            <field name="category_id" ref="category_rental"/>
        </record>

        <record id="group_rental_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_manager'))]"/>
            <field name="category_id" ref="category_rental"/>
        </record>

        <record id="category_sales" model="ir.module.category">
            <field name="name">Sales</field>
            <field name="parent_id" ref="base.module_category_administration"/>
        </record>

        <record id="group_sales_own" model="res.groups">
            <field name="name">Own Documents</field>
            <field name="category_id" ref="category_sales"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user'))
            ]"/>
        </record>

        <record id="group_sales_all" model="res.groups">
            <field name="name">All Documents</field>
            <field name="implied_ids" eval="[(4, ref('group_sales_own'))]"/>
            <field name="category_id" ref="category_sales"/>
        </record>
    </data>
</odoo>