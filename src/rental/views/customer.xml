<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="customer_list" model="ir.ui.view">
            <field name="name">customer_list</field>
            <field name="model">rental.customer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="customer_form" model="ir.ui.view">
            <field name="name">customer_form</field>
            <field name="model">rental.customer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Customer"/>
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" options="{'line_breaks': False}" widget="text"
                                           placeholder="e.g. Machine"/>
                                </div>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Orders">
                                <field name="order_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="product_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="customer_action" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="res_model">rental.customer</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="customer_menu" action="customer_action"/>
    </data>
</odoo>