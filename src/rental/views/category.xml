<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="category_list" model="ir.ui.view">
            <field name="name">category_list</field>
            <field name="model">rental.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="category_form" model="ir.ui.view">
            <field name="name">category_form</field>
            <field name="model">rental.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Category"/>
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" options="{'line_breaks': False}" widget="text"
                                           placeholder="e.g. Machine"/>
                                </div>
                            </h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="category_action" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">rental.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="category_menu" action="category_action"/>
    </data>
</odoo>